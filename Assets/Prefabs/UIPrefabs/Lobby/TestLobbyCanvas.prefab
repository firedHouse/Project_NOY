    - target: {fileID: 6796728552744708567, guid: aefd370f0b5f1bf43b9ddc918d43fd9a, type: 3}
      propertyPath: m_Text
      value: "\uD3C9\uC18C\uC5D0\uB294 \uC870\uC6A9\uD558\uACE0 \uC0AC\uC0C9\uC744
        \uC990\uAE30\uB294 \uBB38\uD559 \uC18C\uB140 \uAC19\uC9C0\uB9CC \uAE30\uD0C0\uB97C
        \uC7A1\uB294 \uC21C\uAC04 180\uB3C4 \uB3CC\uBCC0\uD558\uC5EC \uC804\uC7A5\uC744
        \uC9C0\uBC30\uD558\uB294 \uB85D\uC2A4\uD0C0\uAC00 \uB41C\uB2E4. \uB9D0\uBCF4\uB2E4\uB294
        \uC120\uC728\uB85C \uC18C\uD1B5\uD558\uB294 \uAC83\uC744 \uC120\uD638\uD558\uBA70
        \uC790\uC2E0\uC758 \uAC10\uC815\uC744 \uC5F0\uC8FC\uC5D0 \uC2E4\uC5B4 \uBCF4\uB0B8\uB2E4."
      objectReference: {fileID: 0}
